// Prisma schema — Lubin Investment
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // native       → macOS local dev (Darwin arm64/x64)
  // rhel-openssl-3.0.x → Vercel serverless runtime (Amazon Linux 2023, OpenSSL 3)
  // Sans ce target, Prisma plante au cold start : "Could not load engine"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // url       = connexion POOLÉE (PgBouncer) → runtime de l'app (Vercel lambda).
  url       = env("DATABASE_URL")
  // directUrl = connexion DIRECTE (non poolée) → migrations uniquement.
  // `prisma migrate deploy` pose un advisory lock niveau session : impossible via le pooler
  // (chaque requête part sur un backend différent → lock perdu → timeout P1002). La connexion
  // directe (même host SANS `-pooler`) règle ça. Cf. doc Neon « Connect from Prisma ».
  directUrl = env("DIRECT_URL")
}

/// Utilisateur — auth email/password locale (pas de social pour le moment).
/// Le passwordHash est un bcrypt cost 12. L'email est normalisé en lowercase à l'insert.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  /// Prénom / nom saisis à l'inscription. Nullable : les comptes créés avant cette
  /// colonne n'en ont pas (les initiales du menu sont alors dérivées de l'email).
  firstName     String?
  lastName      String?
  /// Email vérifié via le lien envoyé à l'inscription. Non bloquant (signal de confiance).
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  // ─── Abonnement Stripe ─────────────────────────────────────────────────────
  /// Customer ID Stripe — créé au premier checkout, réutilisé pour le portail
  /// de gestion d'abonnement. Null tant que l'utilisateur n'a jamais tenté un
  /// paiement.
  stripeCustomerId             String?   @unique
  /// Statut d'abonnement : `free` (défaut), `active`, `past_due`, `canceled`,
  /// `unpaid`, `incomplete`, `incomplete_expired`. Mis à jour par le webhook
  /// Stripe (customer.subscription.created/updated/deleted).
  subscriptionStatus           String    @default("free")
  /// Plan en cours : `monthly` ou `yearly` (null si free).
  subscriptionPlan             String?
  /// Fin de la période payée en cours — l'accès Pro reste actif jusqu'à cette
  /// date même si l'utilisateur a déjà annulé (renouvellement off). Source de
  /// vérité pour le gate `isPro` côté API.
  subscriptionCurrentPeriodEnd DateTime?
  /// Stripe subscription ID — utile pour les webhooks et le portail.
  stripeSubscriptionId         String?   @unique

  // ─── Quota d'analyses gratuites ────────────────────────────────────────────
  /// Nombre d'analyses faites aujourd'hui (UTC). Reset par dailyAnalysisResetAt.
  /// Non utilisé pour les utilisateurs Pro (= illimité).
  dailyAnalysisCount   Int      @default(0)
  /// Date du début de la fenêtre 24h en cours. Le compteur reset quand un
  /// nouvel appel arrive après que 24h se soient écoulées depuis cette date.
  dailyAnalysisResetAt DateTime @default(now())

  // ─── Offre SEO : niveau de plan + quota d'audits ───────────────────────────
  /// Niveau de l'offre SEO : `free` | `solo` | `studio` | `agency`.
  ///
  /// Distinct de `subscriptionPlan`, qui dit la PÉRIODICITÉ (`monthly`/`yearly`) de
  /// l'abonnement historique Lubin Investment. Ici c'est le NIVEAU de service, dérivé du
  /// price ID Stripe par `seoTierFromPriceId`. Les deux coexistent : un abonné Pro
  /// « investissement » n'est pas automatiquement client de l'offre SEO.
  ///
  /// `free` par défaut, y compris pour les comptes existants — aucune régression.
  seoTier             String   @default("free")
  /// Nombre d'audits complets lancés dans la fenêtre de 30 jours en cours.
  /// Le test de visibilité IA n'est JAMAIS décompté ici : c'est l'outil d'acquisition,
  /// il reste gratuit et illimité pour tout le monde.
  monthlyAuditCount   Int      @default(0)
  /// Début de la fenêtre glissante de 30 jours. Même motif que dailyAnalysisResetAt :
  /// reset paresseux au premier appel arrivant après expiration, pas de cron.
  monthlyAuditResetAt DateTime @default(now())

  watchlist          WatchlistEntry[]
  siteAudits         SiteAudit[]
  portfolio          PortfolioPosition[]
  oauthAuthCodes     OAuthAuthCode[]
  oauthRefreshTokens OAuthRefreshToken[]
}

/// Position du portefeuille personnel suivi (page « Stratégie portefeuille »). Achats et ventes
/// saisis manuellement par le propriétaire → alimente le suivi forward « Ma sélection » comparé
/// au S&P 500 et au panier value+momentum. Position ouverte tant que sellDate est null.
model PortfolioPosition {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  /// Date d'achat (YYYY-MM-DD).
  buyDate   String
  /// Prix d'achat (fill réel saisi par l'utilisateur).
  buyPrice  Float
  /// Date de vente (YYYY-MM-DD) ; null = position toujours ouverte.
  sellDate  String?
  /// Prix de vente ; null tant que la position est ouverte.
  sellPrice Float?
  /// Thèse / note libre (optionnel).
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Analyse qualitative du BUSINESS MODEL — cache À VIE (immutable une fois généré).
///
/// Pourquoi immutable : le business model d'une boîte évolue à l'échelle des années
/// (refonte produit, pivot stratégique), pas des semaines. Et chaque génération coûte
/// un appel GPT-4o-search-preview (~$0.05-0.10). On freeze pour éviter de cramer la clé
/// API à chaque rechargement. Si vraiment il faut regénérer (rare cas), suppression
/// manuelle de la ligne DB.
///
/// verdictDirect = la 1-2 phrases punchy affichée en haut du ScoreCard. Vit avec
/// business car concerne le nature de la société.
model BusinessAnalysis {
  ticker        String
  /// Langue de l'analyse (fr/en/es) — cache séparé par langue.
  lang          String   @default("fr")
  /// JSON contenant business: Criterion[] (10 critères)
  business      Json
  /// 1-2 phrases punchy
  verdictDirect String
  /// « Part de marché du moment » — un Criterion enrichi (part estimée + tendance + concurrents
  /// + source), généré avec l'analyse business. Affiché dans la partie quali mais HORS notation.
  /// Nullable : les analyses générées avant cette feature ne l'ont pas (régénération pour l'obtenir).
  marketShare   Json?
  createdAt     DateTime @default(now())

  @@id([ticker, lang])
}

/// Analyse qualitative du MANAGEMENT — RAFRAÎCHISSABLE manuellement.
///
/// Le management peut changer (départ CEO/CFO, scandale, board reshuffle) à des
/// échelles plus courtes que le business. L'utilisateur déclenche un refresh via
/// bouton dédié. Pas de TTL automatique — l'utilisateur sait quand il y a un changement.
model ManagementAnalysis {
  ticker     String
  /// Langue de l'analyse (fr/en/es) — cache séparé par langue.
  lang       String   @default("fr")
  /// JSON contenant management: Criterion[] (5 critères)
  management Json
  updatedAt  DateTime @default(now()) @updatedAt

  @@id([ticker, lang])
}

/// Snapshot Resilience publie, calcule hors du chemin de lecture d'Analyze.
model ResilienceAnalysis {
  ticker          String
  version         String
  status          String
  analysis        Json?
  researchDossier String?
  researchHash    String?
  asOf            DateTime?
  attempts        Int       @default(0)
  lastError       String?
  lastAttemptAt   DateTime?
  createdAt       DateTime  @default(now())
  refreshedAt     DateTime  @default(now())

  @@id([ticker, version])
  @@index([version, status, refreshedAt])
}

model ResilienceAnalysisHistory {
  id              String   @id @default(cuid())
  ticker          String
  version         String
  asOf            DateTime
  analysis        Json
  researchDossier String?
  researchHash    String?
  diff            Json?
  createdAt       DateTime @default(now())

  @@unique([ticker, version, asOf])
  @@index([ticker, version, asOf])
}

/// Score Resilience 5 etoiles (nouveau modele, remplace ResilienceAnalysis A-E/0-100).
/// Ecrit par le backfill de nuit (services/resilienceStars*), lu par l'UI.
/// Chaque critere vaut 0/0,5/1 ; total 0..5. `criteria` = { <axe>: { star, justification } }.
model ResilienceStarScore {
  ticker       String   @id
  name         String?
  /// Somme des 5 etoiles, 0..5 (resolution a la demi-etoile).
  total        Float
  /// { besoin:{star,justification}, controle:{...}, forces:{...}, adjacent:{...}, capture:{...} }
  criteria     Json
  /// Qualite du scoring croise : agree | resolved | flagged (flagged = revue humaine).
  verdict      String   @default("agree")
  /// Modele / version du scoreur ayant produit le total retenu.
  model        String
  /// Totaux des passages Sonnet (tracage de variance).
  sonnetTotals Json?
  /// Total du controle croise DeepSeek-V3 (independant).
  v3Total      Float?
  marketCapUsd Float?
  scoredAt     DateTime @default(now())

  @@index([total])
  @@index([verdict])
}

/// Cache GLOBAL par ticker du résultat de l'analyse quant.
///
/// Source unique de vérité partagée entre /api/analyze et /api/watchlist :
/// quand l'utilisateur clique sur "Analyser" pour un ticker, le résultat (score,
/// chiffres, métriques) est écrit ici. La watchlist lit DIRECTEMENT depuis cette
/// table — elle ne recompute jamais. Conséquence : impossible de diverger.
///
/// Global (pas per-user) car les fundamentaux sont universels.
model TickerQuantSnapshot {
  ticker      String   @id
  snapshot    Json
  refreshedAt DateTime @default(now())

  @@index([refreshedAt])
}

/// Cache PERSISTANT des séries temporelles des graphiques détaillés (histogramme par
/// métrique, P/FCF, Cash ROCE). Persisté en DB (et non en mémoire par instance) → partagé
/// entre toutes les instances de lambda, survit aux cold starts. TTL calé sur le prochain
/// earnings (champ expiresAt) → invalidation post-résultats automatique.
/// Clé = `ticker|metric|freq|years`.
model ChartCache {
  key            String   @id
  points         Json
  source         String
  servedFreq     String?
  annualFallback Boolean?
  expiresAt      DateTime
  storedAt       DateTime @default(now())

  @@index([expiresAt])
}

/// Store PERSISTANT et CANONIQUE des séries trimestrielles brutes de fondamentaux
/// (revenue, cfo, capex, sbc, shares, netIncome, operatingIncome, totalDebt, cash…).
/// = sortie de getReportedTimeseries AVANT ajustement splits : dé-cumulée (YTD→trimestre)
/// + trous comblés via SEC EDGAR. APPEND-ONLY : on n'ajoute que les trimestres absents
/// (nouveaux résultats OU trous anciens nouvellement comblés), jamais d'écrasement d'une
/// valeur existante → stabilité point-in-time + zéro re-fetch entre deux earnings.
/// L'ajustement splits (shares uniquement) est appliqué À LA LECTURE pour qu'un futur split
/// ré-aligne tout l'historique sans figer une base obsolète.
/// `expiresAt` = lastEnd + ~120j (plancher re-check 14j) → re-fetch quand un nouveau trimestre
/// est déposé. Clé = (ticker, metric). Bypass total en replay backtest (non point-in-time).
model FundamentalsSeries {
  ticker    String
  metric    String
  /// TimeseriesPoint[] {date, value} complet, trié ASC, dé-cumulé + EDGAR mergé, PRÉ-split.
  points    Json
  /// 'finnhub' | 'finnhub+edgar' | 'finnhub-empty' | 'yahoo' | 'yahoo-empty'
  source    String
  /// 'quarterly' (US, Finnhub+EDGAR) | 'annual' (non-US, Yahoo). Observabilité — la clé reste
  /// (ticker, metric) car les noms de métriques ne collisionnent pas (revenue vs annualTotalRevenue).
  freq      String   @default("quarterly")
  /// Fin de la dernière période stockée (YYYY-MM-DD). Null si série vide.
  lastEnd   String?
  expiresAt DateTime
  builtAt   DateTime @default(now())

  @@id([ticker, metric])
  @@index([expiresAt])
}

/// Veille quantitative automatique ("screener"). Une ligne par ticker de l'univers.
/// La note /10 (quanti uniquement, jamais de GPT) est recalculée quand `nextEarningsDate`
/// est atteinte — le quantitatif ne bouge qu'aux résultats. Tant que la date est future,
/// le score reste en cache. Le détail complet vit dans TickerQuantSnapshot.
///
/// Couverture progressive : priority 0=US, 1=EU, 2=OTHER (le worker pioche dans cet ordre).
model ScreenerTicker {
  ticker                  String    @id
  exchange                String?
  name                    String?
  currency                String?
  region                  String    @default("US")
  priority                Int       @default(0)
  /// pending | scored | nodata | error
  status                  String    @default("pending")
  scoreChiffres           Int?
  scoreChiffresMax        Int?
  /// scoreChiffres / scoreChiffresMax — indexé pour le tri "meilleures notes"
  scoreRatio              Float?
  pfcfTTM                 Float?
  /// Métadonnées d'affichage du screener
  sector                  String?
  price                   Float?
  /// Variation du jour en %
  dayChangePct            Float?
  /// Capitalisation boursière figée au scoring, en DEVISE LOCALE du titre (donc en pence pour
  /// Londres, en yens pour Tokyo). Recoupée entre le recalcul prix × actions et la valeur publiée
  /// par le fournisseur, cf. services/marketCapResolve.ts. Null quand rien n'est vérifiable.
  /// Sert à l'AFFICHAGE ; ne jamais y appliquer un seuil en dollars.
  marketCap               Float?
  /// marketCap normalisé en USD (table de change statique, cf. marketTiers.ts). C'est la colonne
  /// COMPARABLE entre bourses : elle porte le filtre Small/Mid/Large du screener ET les tiers de
  /// cadence de re-scoring. Null quand la capitalisation n'est pas déterminable.
  marketCapUsd            Float?
  /// Closes mensuels ~1 an pour la sparkline (number[])
  spark                   Json?
  fundamentalsSource      String?
  /// Date du prochain earnings (YYYY-MM-DD) — pilote le re-scoring
  nextEarningsDate        String?
  /// Dernière fois que les DONNÉES FINANCIÈRES de ce titre ont réellement CHANGÉ (nouveau
  /// trimestre publié, révision des comptes). PAS la dernière fois qu'on a fait tourner le
  /// scoring : un re-scoring qui retrouve les mêmes fondamentaux ne touche PAS ce champ.
  /// C'est ce qui alimente `dateModified` (JSON-LD) et `lastmod` (sitemap), donc ça doit
  /// rester un signal de fraîcheur HONNÊTE. Bumper la date sans changement de contenu est
  /// mesuré comme contre-productif quand c'est fait en masse.
  /// ⚠️ Pour la CADENCE de re-scoring, utiliser `lastAttemptAt`, jamais ce champ.
  lastScoredAt            DateTime?
  /// Dernière TENTATIVE de scoring, qu'elle ait réussi ou échoué. Pilote toute la cadence :
  /// cooldown de re-tentative, TTL de rafraîchissement par tier, ordre de la file.
  /// Séparé de `lastScoredAt` depuis 2026-08-04 : avant, un échec transitoire (throttle Yahoo
  /// depuis les IP Vercel) bumpait `lastScoredAt` et faisait donc avancer le `lastmod` SEO
  /// sans qu'une seule donnée ait changé.
  lastAttemptAt           DateTime?
  /// Empreinte des fondamentaux INDÉPENDANTS DU COURS (note + marges, croissances, ROCE,
  /// dette, CCC…). Sert uniquement à répondre à « est-ce que de vraies nouvelles données
  /// sont arrivées ? ». Exclut délibérément prix, capitalisation et P/FCF, qui bougent
  /// chaque jour sans qu'aucun compte n'ait été publié.
  fundamentalsFingerprint String?
  attempts                Int       @default(0)
  /// Dernière fois que les séries de graphiques (ChartCache) ont été préremplies pour ce
  /// ticker. Null = jamais → la veille les comble progressivement (comme elle a scoré l'univers).
  chartsWarmedAt          DateTime?
  /// « Opportunité du moment » : P/FCF dans son décile bas historique (≤10) ET < 25.
  opportunity             Boolean   @default(false)
  /// Percentile actuel du P/FCF vs son historique (0-100). Null si indisponible.
  pfcfPercentile          Float?
  /// Seuil P/FCF du décile bas historique (valeur au 10e percentile), figé au scoring.
  /// Permet de RÉ-ÉVALUER l'opportunité EN LIVE (pfcf_live ≤ pfcfDecile10) avec juste le prix
  /// du jour, sans recharger toute la distribution. La distribution ne bouge qu'aux earnings.
  pfcfDecile10            Float?
  /// Dernière ré-évaluation LIVE du flag opportunity (au prix du jour). Pilote le throttle (~10 min).
  oppRefreshedAt          DateTime?
  updatedAt               DateTime  @updatedAt

  /// Index de la FILE de scoring : elle trie et filtre désormais sur lastAttemptAt.
  @@index([status, priority, lastAttemptAt])
  @@index([scoreRatio])
  @@index([opportunity])
}

/// Watchlist par utilisateur. Un même ticker peut apparaître chez plusieurs users (différentes lignes).
/// Les champs `snapshot` + `refreshedAt` sont legacy — gardés pour backward-compat mais
/// plus utilisés depuis l'introduction de TickerQuantSnapshot (cache global).
model WatchlistEntry {
  id          Int       @id @default(autoincrement())
  userId      String
  ticker      String
  addedAt     DateTime  @default(now())
  /// Snapshot du dernier refresh (P/FCF, score chiffres, etc.) — nullable au premier ajout
  snapshot    Json?
  /// Date du dernier rafraîchissement
  refreshedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Un user ne peut pas avoir le même ticker deux fois
  @@unique([userId, ticker])
  @@index([userId])
}

/// Phrase de présentation d'entreprise (longBusinessSummary Yahoo), traduite UNE FOIS puis
/// stockée par ticker dans les 3 langues. Évite de re-traduire à chaque requête. `en` est la
/// source Yahoo et sert de clé de fraîcheur : si elle change, fr/es sont ré-traduits.
model BusinessDescription {
  ticker    String   @id
  en        String?
  fr        String?
  es        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
// OAuth 2.1 — serveur d'autorisation pour le connecteur MCP (claude.ai).
//
// Le endpoint MCP (/api/mcp) est une « protected resource » OAuth. L'utilisateur
// relie son compte Lubin Investment depuis claude.ai via un flow Authorization
// Code + PKCE. Le client (claude.ai) s'enregistre dynamiquement (RFC 7591) →
// OAuthClient. Le consentement émet un OAuthAuthCode (usage unique, court).
// L'échange au /token émet un access token (JWT court, NON stocké, secret dérivé
// d'AUTH_SECRET) + un OAuthRefreshToken (opaque, stocké HASHÉ, révocable, à
// rotation). Le gating Pro/membre reste côté serveur (isProActive) au moment de
// l'appel du tool — il est INDÉPENDANT du scope OAuth.
// ═══════════════════════════════════════════════════════════════════════════

/// Client OAuth enregistré dynamiquement (RFC 7591) par un client MCP (ex. le
/// connecteur claude.ai). Public client + PKCE : `clientSecret` reste null,
/// l'identité du client est prouvée par le `code_verifier`. `redirectUris` est une
/// allowlist STRICTE (match exact exigé au /authorize et au /token).
model OAuthClient {
  id                      String   @id @default(cuid()) // = client_id
  /// Null pour un client public (PKCE). Rempli seulement si un client confidentiel s'enregistre.
  clientSecret            String?
  clientName              String?
  /// string[] — URIs de redirection autorisées (match exact).
  redirectUris            Json
  /// string[] — ex. ["authorization_code","refresh_token"].
  grantTypes              Json
  /// string[] — ex. ["code"].
  responseTypes           Json
  /// "none" (public, défaut) | "client_secret_basic" | "client_secret_post".
  tokenEndpointAuthMethod String   @default("none")
  scope                   String?
  createdAt               DateTime @default(now())

  authCodes     OAuthAuthCode[]
  refreshTokens OAuthRefreshToken[]
}

/// Code d'autorisation OAuth — USAGE UNIQUE, courte durée (~10 min). Émis après le
/// consentement de l'utilisateur, échangé UNE seule fois au /token contre des
/// tokens. Porte le PKCE challenge (S256) vérifié à l'échange.
model OAuthAuthCode {
  /// Valeur opaque aléatoire (le code lui-même) — sert de clé primaire.
  code                String    @id
  clientId            String
  userId              String
  redirectUri         String
  scope               String?
  /// PKCE — base64url(sha256(code_verifier)) fourni au /authorize.
  codeChallenge       String
  /// Seul "S256" est accepté (OAuth 2.1 interdit "plain").
  codeChallengeMethod String    @default("S256")
  /// Resource indicator (RFC 8707) — l'URL du MCP à qui le token est destiné.
  resource            String?
  expiresAt           DateTime
  /// Non-null dès que le code a été échangé → rejet de tout ré-usage.
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Refresh token OAuth — opaque, stocké HASHÉ (sha256, jamais en clair). Révocable
/// et à rotation (chaque usage émet un nouveau refresh et révoque l'ancien). Permet
/// de réémettre un access token court sans redemander le login.
model OAuthRefreshToken {
  id        String    @id @default(cuid())
  /// sha256(token) en hex. Unique → lookup direct à l'échange.
  tokenHash String    @unique
  clientId  String
  userId    String
  scope     String?
  resource  String?
  expiresAt DateTime
  /// Non-null si révoqué (rotation, logout, ou révocation admin).
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Audit SEO historisé — un enregistrement par site et par passage.
///
/// C'est la table qui transforme un audit ponctuel en abonnement : sans historique, on vend
/// un one-shot ; avec, on peut dire « tu as corrigé A1 il y a trois semaines, voilà ce que
/// ton taux d'indexation a fait depuis ». Sur un canal où les effets prennent des semaines,
/// c'est la seule façon de prouver la valeur.
///
/// C'est aussi la matière du comparatif sectoriel : la médiane par stack et par taille de
/// site se calcule sur l'agrégat de cette table. Personne ne peut la copier, et elle
/// s'améliore à chaque client — donc elle ne stocke QUE des données publiques (ce que
/// n'importe qui verrait en visitant le site), jamais de contenu privé.
model SiteAudit {
  id       String @id @default(cuid())
  userId   String
  /// Hôte canonique audité (`exemple.fr`), sans schéma ni slash final. Sert de clé de
  /// regroupement pour l'historique d'un même site.
  host     String
  /// URL exacte du point d'entrée demandé.
  entryUrl String

  createdAt DateTime @default(now())
  /// Plan au moment de l'audit — un historique doit rester interprétable même si
  /// l'utilisateur change de palier ensuite (le plafond de crawl appliqué en dépend).
  tier      String

  // ─── Indicateurs suivis dans le temps ────────────────────────────────────
  /// Verdict de rendu du point d'entrée : `ssr` | `dynamic` | `invisible` | `thin`.
  renderVerdict  String
  /// Pages réellement examinées (borné par le plafond du plan).
  pagesCrawled   Int
  /// Pages découvertes mais NON examinées faute de plafond. Non nul = l'utilisateur voit
  /// concrètement ce que son palier lui coûte, sans qu'on ait à le lui dire.
  pagesSkipped   Int     @default(0)
  /// Nombre de constats par gravité, pour tracer une courbe sans relire le détail.
  blockingCount  Int     @default(0)
  warnCount      Int     @default(0)
  /// Mots médians vus par un robot d'IA sur les pages examinées.
  medianBotWords Int     @default(0)
  /// Pages orphelines détectées (A5), profondeur maximale constatée (A6).
  orphanCount    Int     @default(0)
  maxDepth       Int     @default(0)
  /// Stack devinée depuis les en-têtes et le HTML (`next`, `vite`, `webflow`, `wordpress`…).
  /// Sert d'axe au comparatif sectoriel : la médiane n'a de sens qu'à stack comparable.
  stack          String?

  /// Rapport complet sérialisé (constats, par page). Json et pas des colonnes : le format
  /// des constats bougera à chaque mise à jour du corpus, et on ne veut pas une migration
  /// par nouvelle vérification.
  report Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
